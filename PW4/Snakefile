    input:
        "data/concrete.csv",
        "sessionA.py"
    output:
        "results/A_metrics.csv"
    shell:
        "python3 sessionA.py"

rule session_b:
    input:
        "sessionB.py"
    output:
        "results/B_agreement.csv"
    shell:
